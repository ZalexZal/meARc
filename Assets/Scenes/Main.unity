  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412\u0441\u0435\u043A\u0438 \u043C\u043E\u0436\u0435 \u0434\u0430 \u043F\u043E\u0441\u0442\u0430\u0432\u0438
    \u0441\u043F\u0438\u0440\u043A\u0430. \u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0432\u0430\u043C\u0435
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430, \u043F\u0440\u0435\u0434\u0438
    \u0434\u0430 \u0441\u0442\u0430\u043D\u0435 \u043F\u0443\u0431\u043B\u0438\u0447\u0435\u043D,
    \u043D\u043E \u043D\u0435 \u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0442\u0435,
    \u0441\u043F\u043E\u0434\u0435\u043B\u0435\u043D\u0438 \u0441 \u043A\u043E\u0434.
    \u0410\u043A\u043E \u043D\u044F\u043A\u043E\u044F \u0442\u0438 \u043F\u0440\u0435\u0447\u0438,
    \u201E\u0421\u043A\u0440\u0438\u0439\u201C \u044F \u043C\u0430\u0445\u0430 \u043E\u0442
    \u043A\u0430\u0440\u0442\u0430\u0442\u0430 \u0442\u0438 \u0432\u0435\u0434\u043D\u0430\u0433\u0430,
    \u201E\u0414\u043E\u043A\u043B\u0430\u0434\u0432\u0430\u0439\u201C \u043D\u0438
    \u043A\u0430\u0437\u0432\u0430, \u0430 \u201E\u0411\u043B\u043E\u043A\u0438\u0440\u0430\u0439\u201C
    \u0441\u043A\u0440\u0438\u0432\u0430 \u0432\u0441\u0438\u0447\u043A\u043E, \u043D\u0430\u043F\u0440\u0430\u0432\u0435\u043D\u043E
    \u043E\u0442 \u0442\u043E\u0437\u0438 \u0447\u043E\u0432\u0435\u043A. \u0424\u0430\u043B\u0448\u0438\u0432\u043E\u0442\u043E
    \u043C\u0435\u0441\u0442\u043E\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    \u0435 \u043F\u0440\u043E\u0442\u0438\u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0442\u0430."
