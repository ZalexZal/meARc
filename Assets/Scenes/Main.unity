  m_text: "\u0422\u043E\u0432\u0430 \u043D\u0435 \u0435 \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044F.
    \u0427\u0435\u0440\u0442\u0430\u0435 \u043F\u0440\u0430\u0432\u0430 \u043B\u0438\u043D\u0438\u044F
    \u0434\u043E \u0441\u043F\u0438\u0440\u043A\u0430\u0442\u0430, \u0430 \u043D\u0435
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442, \u0438 \u043D\u0435 \u0437\u043D\u0430\u0435
    \u043D\u0438\u0449\u043E \u0437\u0430 \u0443\u043B\u0438\u0446\u0438 \u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435.
    \u0412\u0434\u0438\u0433\u043D\u0438 \u043F\u043E\u0433\u043B\u0435\u0434."
