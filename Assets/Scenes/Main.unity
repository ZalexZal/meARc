  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041A\u0430\u0440\u0442\u0430: \xA9 Stadia Maps, \xA9 OpenMapTiles, \xA9
    \u0441\u044A\u0442\u0440\u0443\u0434\u043D\u0438\u0446\u0438\u0442\u0435 \u043D\u0430
    OpenStreetMap.\n\n\u0412\u0441\u0435\u043A\u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442,
    \u0441\u043F\u0438\u0440\u043A\u0430, \u0441\u043D\u0438\u043C\u043A\u0430 \u0438
    \u0437\u0430\u043F\u0438\u0441 \u0435 \u0441\u044A\u0437\u0434\u0430\u0434\u0435\u043D
    \u043E\u0442 \u0430\u0432\u0442\u043E\u0440\u0430 \u043D\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430
    \u0438 \u0435 \u043D\u0435\u0433\u043E\u0432. \u0410\u043A\u043E \u043D\u0435\u0449\u043E
    \u043D\u0435 \u0431\u0438\u0432\u0430 \u0434\u0430 \u0435 \u0442\u0430\u043C,
    \u0434\u043E\u043A\u043B\u0430\u0434\u0432\u0430\u0439\u0442\u0435 \u0433\u043E
    \u043E\u0442 \u0441\u0430\u043C\u0430\u0442\u0430 \u0441\u043F\u0438\u0440\u043A\u0430.\n\n\u041A\u0430\u043C\u0435\u0440\u0430:
    \u0442\u043E\u0432\u0430 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    \u0440\u0430\u0431\u043E\u0442\u0438 \u0441 Google Play Services for AR (ARCore),
    \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u044F\u043D\u043E \u043E\u0442
    Google \u0438 \u043F\u043E\u0434\u0447\u0438\u043D\u0435\u043D\u043E \u043D\u0430
    \u041F\u043E\u043B\u0438\u0442\u0438\u043A\u0430\u0442\u0430 \u0437\u0430 \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u0435\u043B\u043D\u043E\u0441\u0442
    \u043D\u0430 Google.\n\n\u0428\u0440\u0438\u0444\u0442: Inter \u043E\u0442 Rasmus
    Andersson, \u043F\u043E\u0434 \u043B\u0438\u0446\u0435\u043D\u0437\u0430 SIL
    Open Font License."
