  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u0440\u043E\u0444\u0438\u043B\u044A\u0442 \u043F\u043E\u043C\u043D\u0438
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0442\u0435 \u0442\u0438, \u043E\u0442\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435
    \u043D\u0430 \u043E\u0442\u0431\u043E\u0440\u0430 \u0438 \u0437\u043D\u0430\u0447\u043A\u0438\u0442\u0435.
    \u0417\u0430 13 \u0438 \u043F\u043E\u0432\u0435\u0447\u0435 \u0433\u043E\u0434\u0438\u043D\u0438
    \u0435, \u0430 \u043D\u0430 13 \u043F\u044A\u0440\u0432\u043E \u0442\u0440\u044F\u0431\u0432\u0430
    \u0434\u0430 \u0441\u0435 \u0441\u044A\u0433\u043B\u0430\u0441\u0438 \u0440\u043E\u0434\u0438\u0442\u0435\u043B
    \u0438\u043B\u0438 \u043D\u0430\u0441\u0442\u043E\u0439\u043D\u0438\u043A. \u041C\u043E\u0436\u0435\u0448
    \u0434\u0430 \u0433\u043E \u0438\u0437\u0442\u0440\u0438\u0435\u0448 \u043F\u043E
    \u0432\u0441\u044F\u043A\u043E \u0432\u0440\u0435\u043C\u0435 \u0432 \u0440\u0430\u0437\u0434\u0435\u043B\u0430
    \u201E\u041F\u0440\u043E\u0444\u0438\u043B\u201C."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dbaf15348bd3df94bbae9102e3772892, type: 2}
