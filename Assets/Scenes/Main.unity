  m_text: "\u041D\u0435 \u0432\u0438\u0436\u0434\u0430\u0448 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0442\u0435
    \u0438\u043C \u0438 \u0438\u043C\u0435\u043D\u0430\u0442\u0430 \u043D\u0430 \u043E\u0442\u0431\u043E\u0440\u0438\u0442\u0435
    \u0438\u043C, \u0430 \u0442\u0435 \u043D\u0435 \u043C\u043E\u0433\u0430\u0442
    \u0434\u0430 \u0432\u043B\u0438\u0437\u0430\u0442 \u0432 \u0442\u0432\u043E\u0438\u0442\u0435
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438. \u0410\u043A\u043E \u043E\u0442\u0431\u043B\u043E\u043A\u0438\u0440\u0430\u0448,
    \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u0438\u0442\u0435 \u0438\u043C \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438
    \u0441\u0435 \u0432\u0440\u044A\u0449\u0430\u0442 \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430\u0442\u0430
    \u0442\u0438."
