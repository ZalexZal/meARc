  m_text: "\u0412\u0441\u044F\u043A\u0430 \u0441\u0442\u0440\u0435\u043B\u043A\u0430
    \u043C\u0435\u0441\u0442\u0438 \u0441\u043F\u0438\u0440\u043A\u0430\u0442\u0430
    \u0441 \u0435\u0434\u0438\u043D \u043C\u0435\u0442\u044A\u0440 \u0441\u043F\u0440\u044F\u043C\u043E
    \u043F\u043E\u0441\u043E\u043A\u0430\u0442\u0430, \u0432 \u043A\u043E\u044F\u0442\u043E
    \u0433\u043B\u0435\u0434\u0430\u0448. \u0417\u0430\u043F\u0430\u0437\u0438, \u043A\u043E\u0433\u0430\u0442\u043E
    \u043C\u0430\u0440\u043A\u0435\u0440\u044A\u0442 \u0437\u0430\u0441\u0442\u0430\u043D\u0435
    \u043D\u0430 \u043C\u044F\u0441\u0442\u043E\u0442\u043E."
