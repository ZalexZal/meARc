  m_text: "\u0414\u0430\u0439 \u0433\u043E \u043D\u0430 \u0445\u043E\u0440\u0430\u0442\u0430,
    \u043A\u043E\u0438\u0442\u043E \u0432\u044A\u0440\u0432\u044F\u0442 \u0441 \u0442\u0435\u0431.
    \u041F\u0438\u0448\u0430\u0442 \u0433\u043E \u0432 \u201E\u0418\u043C\u0430\u043C
    \u043A\u043E\u0434\u201C \u0438 \u0432\u043B\u0438\u0437\u0430\u0442 \u0438 \u0432
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430, \u0438 \u0432 \u043E\u0442\u0431\u043E\u0440\u0430
    \u0442\u0438."
