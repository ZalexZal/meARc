  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0418\u0437\u0432\u044A\u0440\u0432\u044F\u043D\u043E\u0442\u043E \u0441\u0435
    \u043F\u0430\u0437\u0438 \u0441\u0430\u043C\u043E \u043D\u0430 \u0442\u043E\u0437\u0438
    \u0442\u0435\u043B\u0435\u0444\u043E\u043D. \u041D\u0430\u043F\u0440\u0430\u0432\u0438
    \u043F\u0440\u043E\u0444\u0438\u043B \u0438 \u0442\u043E \u0449\u0435 \u0442\u0435
    \u0441\u043B\u0435\u0434\u0432\u0430 \u043D\u0430 \u0434\u0440\u0443\u0433 \u0442\u0435\u043B\u0435\u0444\u043E\u043D
    \u0438 \u0432 \u0441\u0430\u0439\u0442\u0430. \u0410\u043A\u043E \u0441\u0438
    \u043D\u0430 13, \u0440\u043E\u0434\u0438\u0442\u0435\u043B \u0438\u043B\u0438
    \u043D\u0430\u0441\u0442\u043E\u0439\u043D\u0438\u043A \u0442\u0440\u044F\u0431\u0432\u0430
    \u0434\u0430 \u0441\u0435 \u0441\u044A\u0433\u043B\u0430\u0441\u0438, \u043F\u0440\u0435\u0434\u0438
    \u0434\u0430 \u0432\u043B\u0435\u0437\u0435\u0448 \u0432 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
    \u2013 \u043A\u0430\u0442\u043E \u0433\u043E\u0441\u0442 \u0438\u043B\u0438 \u0441
    \u043F\u0440\u043E\u0444\u0438\u043B."
  m_isRightToLeft: 0
