  m_text: "\u0417\u0430 \u0434\u0430 \u0440\u0430\u0431\u043E\u0442\u0438 \u0442\u0430\u0437\u0438
    \u0441\u0435\u0441\u0438\u044F, Google \u0449\u0435 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0432\u0430
    \u0434\u0430\u043D\u043D\u0438 \u043E\u0442 \u0441\u0435\u043D\u0437\u043E\u0440\u0438\u0442\u0435
    (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 \u043A\u0430\u043C\u0435\u0440\u0430\u0442\u0430
    \u0438 \u043C\u0435\u0441\u0442\u043E\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u0442\u043E).
    \u0422\u0430\u043A\u0430 \u043C\u0430\u0440\u043A\u0435\u0440\u0438\u0442\u0435
    \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0442 \u043D\u0430 \u0442\u043E\u0447\u043D\u043E\u0442\u043E
    \u043C\u044F\u0441\u0442\u043E \u043D\u0430 \u0443\u043B\u0438\u0446\u0430\u0442\u0430."
  m_isRightToLeft: 0
