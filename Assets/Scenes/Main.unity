  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "AR Trail \u0435 \u0441\u044A\u043A\u0440\u043E\u0432\u0438\u0449\u0435\u043D
    \u043B\u043E\u0432 \u0432 \u0442\u0432\u043E\u044F \u0433\u0440\u0430\u0434:
    \u043D\u0430\u043C\u0435\u0440\u0438 \u0441\u043F\u0438\u0440\u043A\u0438\u0442\u0435,
    \u043E\u0442\u0433\u043E\u0432\u043E\u0440\u0438 \u043D\u0430 \u0432\u044A\u043F\u0440\u043E\u0441\u0438\u0442\u0435,
    \u0438\u0437\u043F\u0440\u0435\u0432\u0430\u0440\u0438 \u0434\u0440\u0443\u0433\u0438\u0442\u0435
    \u043E\u0442\u0431\u043E\u0440\u0438.\n\n\u0421\u044A\u0437\u0434\u0430\u0434\u0435\u043D
    \u043E\u0442 \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u044A\u0440 \u0417\u0430\u043C\u043E\u0432
    \u0432 \u042F\u043C\u0431\u043E\u043B. \u0412\u044A\u043F\u0440\u043E\u0441\u0438
    \u0438 \u043C\u043E\u043B\u0431\u0438: zalex8623@gmail.com.\n\n\u041C\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0442\u0435
    \u0441\u0435 \u043F\u0440\u0430\u0432\u044F\u0442 \u0432 \u0441\u0430\u0439\u0442\u0430
    artrails.netlify.app."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dbaf15348bd3df94bbae9102e3772892, type: 2}
