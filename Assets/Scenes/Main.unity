--- !u!114 &1659231026
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1659231022}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u0440\u0438\u0435\u043C\u0430\u043D\u0435\u0442\u043E \u0437\u0430\u043F\u0438\u0441\u0432\u0430
    \u0434\u0430\u0442\u0430\u0442\u0430, \u0432\u0435\u0440\u0441\u0438\u044F\u0442\u0430
    \u0438 \u043E\u0442\u0433\u043E\u0432\u043E\u0440\u0430 \u0437\u0430 \u0432\u044A\u0437\u0440\u0430\u0441\u0442\u0442\u0430
    \u043A\u044A\u043C \u043F\u0440\u043E\u0444\u0438\u043B\u0430 \u0442\u0438. \u041F\u044A\u043B\u043D\u0438\u0442\u0435
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u0438 \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0430\u0442\u0430
    \u0437\u0430 \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u0435\u043B\u043D\u043E\u0441\u0442
    \u0441\u0430 \u0432 \u0441\u0430\u0439\u0442\u0430 \u0438 \u0432 \u201E\u041F\u0440\u043E\u0444\u0438\u043B\u201C
    \u2192 \u041F\u043E\u043C\u043E\u0449.\n\n\u0422\u043E\u0432\u0430 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    \u0440\u0430\u0431\u043E\u0442\u0438 \u0441 Google Play Services for AR (ARCore),
    \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u044F\u043D\u043E \u043E\u0442
    Google \u0438 \u043F\u043E\u0434\u0447\u0438\u043D\u0435\u043D\u043E \u043D\u0430
    \u041F\u043E\u043B\u0438\u0442\u0438\u043A\u0430\u0442\u0430 \u0437\u0430 \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u0435\u043B\u043D\u043E\u0441\u0442
    \u043D\u0430 Google. \u041F\u043E\u043B\u0437\u0432\u0430\u043D\u0435\u0442\u043E
    \u043D\u0430 ARCore \u0441\u0435 \u043F\u043E\u0434\u0447\u0438\u043D\u044F\u0432\u0430
    \u043D\u0430 \u041E\u0431\u0449\u0438\u0442\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
    \u043D\u0430 Google (policies.google.com/terms) \u0438 \u041F\u043E\u043B\u0438\u0442\u0438\u043A\u0430\u0442\u0430
    \u0437\u0430 \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u0435\u043B\u043D\u043E\u0441\u0442
    \u043D\u0430 Google (google.com/policies/privacy)."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dbaf15348bd3df94bbae9102e3772892, type: 2}
