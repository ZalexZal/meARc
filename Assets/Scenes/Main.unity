  m_text: "\u041C\u043E\u0436\u0435\u0448 \u0434\u0430 \u0432\u044A\u0440\u0432\u0438\u0448
    \u0438 \u0431\u0435\u0437 \u043F\u0440\u043E\u0444\u0438\u043B, \u043D\u043E
    \u0442\u043E\u0433\u0430\u0432\u0430 \u0440\u0430\u0437\u0445\u043E\u0434\u043A\u0430\u0442\u0430
    \u0442\u0438 \u0441\u0435 \u043F\u0430\u0437\u0438 \u0441\u0430\u043C\u043E \u043D\u0430
    \u0442\u043E\u0437\u0438 \u0442\u0435\u043B\u0435\u0444\u043E\u043D. \u0421 \u043F\u0440\u043E\u0444\u0438\u043B
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0442\u0435 \u0438 \u043E\u0442\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435
    \u0442\u0438 \u0441\u0435 \u043F\u0430\u0437\u044F\u0442 \u043D\u0430 \u0432\u0441\u0435\u043A\u0438
    \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u0438 \u0432 \u0441\u0430\u0439\u0442\u0430."
