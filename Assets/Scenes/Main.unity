  m_text: "AR Trail \u0441\u043B\u0430\u0433\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u0438,
    \u0443\u0440\u043E\u0446\u0438 \u0438 \u0431\u044A\u0434\u0435\u0449\u0438 \u0441\u0433\u0440\u0430\u0434\u0438
    \u0432\u044A\u0440\u0445\u0443 \u0438\u0441\u0442\u0438\u043D\u0441\u043A\u0430\u0442\u0430
    \u0443\u043B\u0438\u0446\u0430: \u0440\u0430\u0437\u0445\u043E\u0434\u043A\u0430
    \u0438\u0437 \u0433\u0440\u0430\u0434\u0430, \u0443\u0447\u0438\u043B\u0438\u0449\u0435\u043D
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438\u043B\u0438 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u043D\u0430
    \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0430, \u0432\u0438\u0434\u0435\u043D\u0438
    \u043F\u0440\u0435\u0437 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430.\n\n\u0421\u044A\u0437\u0434\u0430\u0434\u0435\u043D
    \u043E\u0442 \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u044A\u0440 \u0417\u0430\u043C\u043E\u0432
    \u0432 \u042F\u043C\u0431\u043E\u043B. \u0412\u044A\u043F\u0440\u043E\u0441\u0438
    \u0438 \u043C\u043E\u043B\u0431\u0438: zalex8623@gmail.com.\n\n\u041C\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0442\u0435
    \u0441\u0435 \u043F\u0440\u0430\u0432\u044F\u0442 \u0432 \u0441\u0430\u0439\u0442\u0430
    artrails.netlify.app."
