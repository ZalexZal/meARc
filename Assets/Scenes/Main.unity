  m_text: "\u041A\u0430\u0442\u043E \u0437\u0440\u0438\u0442\u0435\u043B \u043D\u0435
    \u0432\u0438 \u043F\u0438\u0442\u0430\u043C\u0435 \u0441 \u043A\u0430\u043A\u0432\u043E
    \u0441\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u0432\u0430\u0442\u0435 \u2014
    \u0449\u0435 \u0432\u0438\u0436\u0434\u0430\u0442\u0435 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u0430\u0442\u0430
    \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430 \u0438 \u0449\u0435
    \u0432\u043B\u0438\u0437\u0430\u0442\u0435 \u0432 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438
    \u0441 \u043A\u043E\u0434. \u0410\u043A\u043E \u043F\u043E-\u043A\u044A\u0441\u043D\u043E
    \u0440\u0435\u0448\u0438\u0442\u0435 \u0434\u0430 \u0441\u044A\u0437\u0434\u0430\u0432\u0430\u0442\u0435,
    \u0449\u0435 \u0438\u0437\u0431\u0435\u0440\u0435\u0442\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u043D\u0438\u0435
    \u0442\u043E\u0433\u0430\u0432\u0430."
