  m_text: "\u041D\u0430 13 \u0433\u043E\u0434\u0438\u043D\u0438 \u0441\u0438, \u0437\u0430\u0442\u043E\u0432\u0430
    \u0440\u043E\u0434\u0438\u0442\u0435\u043B \u0438\u043B\u0438 \u043D\u0430\u0441\u0442\u043E\u0439\u043D\u0438\u043A
    \u0442\u0440\u044F\u0431\u0432\u0430 \u0434\u0430 \u0441\u0435 \u0441\u044A\u0433\u043B\u0430\u0441\u0438,
    \u043F\u0440\u0435\u0434\u0438 \u0434\u0430 \u0432\u043B\u0438\u0437\u0430\u0448
    \u0432 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438. \u041D\u0430\u043F\u0438\u0448\u0438
    \u0438\u043C\u0435\u0439\u043B\u0430 \u043C\u0443: \u0449\u0435 \u043C\u0443
    \u0438\u0437\u043F\u0440\u0430\u0442\u0438\u043C \u043B\u0438\u043D\u043A, \u0437\u0430
    \u0434\u0430 \u043F\u0440\u043E\u0447\u0435\u0442\u0435 \u043A\u0430\u043A\u0432\u043E
    \u0435 AR Trail \u0438 \u0434\u0430 \u0440\u0435\u0448\u0438."
